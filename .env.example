# Kopieren nach .env und ausfüllen. Die .env niemals committen.

# Zugangscode für die App (dringend setzen, wenn die App im Internet erreichbar ist)
TRAINER_TOKEN=

# Garmin, Weg 1 (empfohlen): offizielle Garmin Connect Personal API.
# Key erstellen: https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Garmin, Weg 2 (Reserve): inoffizieller Zugang wie die Garmin-App.
# Besser: einmal "python -m trainer.garmin_login" ausführen, dann werden nur Tokens gespeichert
# und das Passwort kann hier leer bleiben.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# KI-Coach (Claude). Ohne Schlüssel arbeitet die App mit Regeln weiter.
ANTHROPIC_API_KEY=
# TRAINER_MODEL=claude-opus-5-5

# Zeitzone für Kalender
TZ=Europe/Berlin

# Demo-Daten statt Garmin (zum Ausprobieren)
TRAINER_DEMO=off

# Automatisch alle X Stunden Garmin abrufen (0 = aus)
TRAINER_AUTOSYNC_HOURS=3
